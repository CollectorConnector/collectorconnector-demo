import { NextResponse } from "next/server";

export async function POST(req: Request) {
  const { username } = await req.json();

  if (!username) {
    return NextResponse.json({ error: "Username required" }, { status: 400 });
  }

  try {
    // Replace with your real Apify task ID and token
    const scraperRes = await fetch(
      "https://api.apify.com/v2/actor-tasks/YOUR_TASK_ID/run-sync-get-dataset-items?token=YOUR_TOKEN",
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          directUrls: [`https://www.instagram.com/${username}/`],
          resultsLimit: 12, // Adjust as needed
        }),
      }
    );

    if (!scraperRes.ok) {
      throw new Error(`Apify error: ${scraperRes.status}`);
    }

    const posts = await scraperRes.json();

    const formatted = posts.map((p: any) => ({
      id: p.id || Date.now().toString(),
      imageUrl: p.displayUrl || p.imageUrl,
      caption: p.caption || p.text || "",
      timestamp: p.timestamp || null,
    }));

    return NextResponse.json({ posts: formatted });
  } catch (error: any) {
    console.error("Instagram import fetch error:", error);
    return NextResponse.json({ error: "Failed to fetch Instagram posts" }, { status: 500 });
  }
}
